{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Web3 Smart Contract Forensics case",
  "type":"object",
  "required":["case_id","title","severity","record_type","evidence_level","sources"],
  "properties":{
    "case_id":{"type":"string","pattern":"^SCF-[0-9]{4}$"},
    "title":{"type":"string","minLength":3},
    "severity":{"const":"Critical"},
    "record_type":{"enum":["audit_finding","bugfix_review","incident"]},
    "status":{"enum":["candidate","verified","corroborated"]},
    "source_name":{"type":["string","null"]},
    "project":{"type":["string","null"]},
    "vulnerability_class":{"type":["string","null"]},
    "impact":{"type":["string","null"]},
    "cvss":{"type":["number","null"],"minimum":0,"maximum":10},
    "reward_amount":{"type":["number","null"],"minimum":0},
    "reward_currency":{"type":["string","null"]},
    "disclosed":{"type":["string","null"]},
    "evidence_level":{"enum":["primary","corroborated","secondary","candidate"]},
    "sources":{"type":"array","minItems":1,"items":{"type":"string","format":"uri"}},
    "notes":{"type":["string","null"]}
  }
}